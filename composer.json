{
    "name": "ewa/tokeet",
    "type": "library",
    "description": "A Laravel package that provides a clean interface to the Tokeet Property Management API.",
    "keywords": ["Laravel", "PHP", "Tokeet", "API", "Property Management", "Rental", "Vacation Rental"],
    "homepage": "https://github.com/abdullahewa/tokeet",
    "license": "MIT",
    "authors": [
        {
            "name": "abdullah ghanem",
            "email": "3bdullah.ghanem@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ewa\\Tokeet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ewa\\Tokeet\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ewa\\Tokeet\\TokeetServiceProvider"
            ],
            "aliases": {
                "Tokeet": "Ewa\\Tokeet\\Facades\\Tokeet"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-f": "vendor/bin/phpunit --filter"
    }
}
